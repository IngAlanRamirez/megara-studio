---
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<div
  class="bg-surface rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow duration-300"
>
  <div class="text-center mb-4">
    <div
      class="w-16 h-16 bg-primary-light rounded-full flex items-center justify-center mx-auto mb-3"
    >
      <span class="text-2xl">{service.icon}</span>
    </div>
    <h3 class="text-xl font-display font-semibold text-primary-dark mb-2">
      {service.title}
    </h3>
  </div>
  <p class="text-neutral-dark/80 text-center leading-relaxed mb-4">
    {service.description}
  </p>
  <div class="text-center">
    <span class="text-sm text-primary-dark font-medium">
      Duración: {service.duration}
    </span>
  </div>
</div>

