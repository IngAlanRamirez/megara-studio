---
// Props opcionales para personalización
export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Beneficios de la Sanación Integral",
  subtitle = "Descubre cómo nuestras terapias pueden transformar tu vida"
} = Astro.props;

const benefits = [
  {
    icon: "💫",
    title: "Equilibrio emocional",
    description: "Encuentra la paz interior y el balance emocional que necesitas para vivir plenamente"
  },
  {
    icon: "🧲",
    title: "Sanación energética",
    description: "Restaura tu campo energético y libera bloqueos que afectan tu bienestar físico y mental"
  },
  {
    icon: "🌍",
    title: "Terapias a distancia",
    description: "Recibe sanación desde cualquier lugar del mundo, sin importar dónde te encuentres"
  }
];
---

<section class="bg-surface py-20 lg:py-32">
  <div class="container mx-auto px-4">
    <!-- Header de la sección -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-primary-dark mb-6">
        {title}
      </h2>
      <p class="text-xl text-neutral-dark/80 max-w-3xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Grid de beneficios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
      {benefits.map((benefit) => (
        <div class="text-center group">
          <!-- Ícono -->
          <div class="mb-6">
            <div class="w-24 h-24 bg-primary-light/30 rounded-full flex items-center justify-center mx-auto group-hover:bg-primary-light/50 transition-colors duration-300">
              <span class="text-4xl">{benefit.icon}</span>
            </div>
          </div>

          <!-- Título -->
          <h3 class="text-2xl font-display font-semibold text-primary-dark mb-4 group-hover:text-primary transition-colors duration-300">
            {benefit.title}
          </h3>

          <!-- Descripción -->
          <p class="text-neutral-dark/80 leading-relaxed max-w-sm mx-auto">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Elemento decorativo adicional -->
    <div class="mt-16 text-center">
      <div class="inline-flex items-center space-x-2 bg-primary-light/20 px-6 py-3 rounded-full">
        <span class="text-accent text-lg">✨</span>
        <span class="text-primary-dark font-medium">Transforma tu vida desde hoy</span>
        <span class="text-accent text-lg">✨</span>
      </div>
    </div>
  </div>
</section> 