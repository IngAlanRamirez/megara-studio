---
import ServiceCard from "./ServiceCard.astro";
import { getServicesContent } from "../utils/content";

export interface Props {
  title?: string;
  subtitle?: string;
}

const servicesContent = getServicesContent();

const { title = servicesContent.title, subtitle = servicesContent.subtitle } =
  Astro.props;
---

<section class="bg-background py-20 lg:py-32">
  <div class="container mx-auto px-4">
    <!-- Header de la sección -->
    <div class="text-center mb-16">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-primary-dark mb-6"
      >
        {title}
      </h2>
      <p class="text-xl text-neutral-dark/80 max-w-3xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Grid de servicios -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
    >
      {
        servicesContent.items.map((servicio) => (
          <ServiceCard service={servicio} />
        ))
      }
    </div>

    <!-- CTA adicional -->
    <div class="mt-16 text-center">
      <div class="bg-primary-light/20 rounded-2xl p-8 max-w-2xl mx-auto">
        <h3 class="text-2xl font-display font-semibold text-primary-dark mb-4">
          {servicesContent.cta.title}
        </h3>
        <p class="text-neutral-dark/80 mb-6">
          {servicesContent.cta.description}
        </p>
        <a href="/contacto" class="btn-primary inline-flex items-center">
          {servicesContent.cta.buttonText}
          <svg
            class="w-5 h-5 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
