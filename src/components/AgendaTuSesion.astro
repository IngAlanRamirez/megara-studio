---
export interface Props {
  title?: string;
  subtitle?: string;
  calendlyUrl?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  title = "Agenda tu Sesión de Sanación",
  subtitle = "Ofrecemos sesiones en línea vía videollamada. Escoge tu horario ideal.",
  calendlyUrl = "https://calendly.com/megara-studio/consulta-inicial",
  whatsappNumber = "+573001234567",
  whatsappMessage = "Hola! Me gustaría agendar una sesión de sanación. ¿Podrías ayudarme?",
} = Astro.props;

// Función para generar el enlace de WhatsApp
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section class="bg-surface py-20 lg:py-32">
  <div class="container mx-auto px-4">
    <!-- Header de la sección -->
    <div class="text-center mb-16">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-primary-dark mb-6"
      >
        {title}
      </h2>
      <p class="text-xl text-neutral-dark/80 max-w-3xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Contenido principal -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Información y beneficios -->
      <div class="space-y-8">
        <!-- Beneficios de las sesiones online -->
        <div class="bg-primary-light/20 rounded-xl p-8">
          <h3
            class="text-2xl font-display font-semibold text-primary-dark mb-6"
          >
            ¿Por qué elegir sesiones online?
          </h3>
          <div class="space-y-4">
            <div class="flex items-start space-x-3">
              <div
                class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-1"
              >
                <svg
                  class="w-4 h-4 text-white"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-display font-medium text-primary-dark">
                  Comodidad total
                </h4>
                <p class="text-neutral-dark/70 text-sm">
                  Desde la comodidad de tu hogar, sin desplazamientos
                </p>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div
                class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-1"
              >
                <svg
                  class="w-4 h-4 text-white"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-display font-medium text-primary-dark">
                  Horarios flexibles
                </h4>
                <p class="text-neutral-dark/70 text-sm">
                  Sesiones disponibles en diferentes zonas horarias
                </p>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div
                class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-1"
              >
                <svg
                  class="w-4 h-4 text-white"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-display font-medium text-primary-dark">
                  Misma efectividad
                </h4>
                <p class="text-neutral-dark/70 text-sm">
                  La energía de sanación no conoce fronteras físicas
                </p>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div
                class="w-6 h-6 bg-primary rounded-full flex items-center justify-center flex-shrink-0 mt-1"
              >
                <svg
                  class="w-4 h-4 text-white"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-display font-medium text-primary-dark">
                  Grabación disponible
                </h4>
                <p class="text-neutral-dark/70 text-sm">
                  Recibe un resumen de tu sesión para recordar
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Información de preparación -->
        <div class="bg-secondary-light/30 rounded-xl p-8">
          <h3
            class="text-xl font-display font-semibold text-secondary-dark mb-4"
          >
            📋 Preparación para tu sesión
          </h3>
          <ul class="space-y-2 text-neutral-dark/80 text-sm">
            <li class="flex items-center space-x-2">
              <span class="text-accent">•</span>
              <span>Encuentra un espacio tranquilo y privado</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-accent">•</span>
              <span>Asegúrate de tener buena conexión a internet</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-accent">•</span>
              <span>Ten papel y lápiz para tomar notas</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-accent">•</span>
              <span>Llega 5 minutos antes para prepararte</span>
            </li>
          </ul>
        </div>

        <!-- Botón alternativo WhatsApp -->
        <div class="text-center">
          <p class="text-neutral-dark/70 mb-4">
            ¿Prefieres agendar por WhatsApp?
          </p>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-green-500 text-white font-medium rounded-lg hover:bg-green-600 transition-colors duration-300 shadow-lg hover:shadow-xl"
          >
            <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"
              ></path>
            </svg>
            Agendar por WhatsApp
          </a>
        </div>
      </div>

      <!-- Calendly iframe -->
      <div
        class="bg-white rounded-xl shadow-lg p-8 border border-primary-light/20"
      >
        <div class="text-center mb-6">
          <h3
            class="text-2xl font-display font-semibold text-primary-dark mb-2"
          >
            Selecciona tu horario
          </h3>
          <p class="text-neutral-dark/70">
            Elige la fecha y hora que mejor te convenga
          </p>
        </div>

        <!-- Placeholder del iframe de Calendly -->
        <div
          class="bg-gray-100 rounded-lg p-8 text-center border-2 border-dashed border-gray-300"
        >
          <div class="text-gray-500 mb-4">
            <svg
              class="w-16 h-16 mx-auto mb-4"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <h4 class="text-lg font-medium text-gray-700 mb-2">
            Calendly Integration
          </h4>
          <p class="text-gray-500 text-sm mb-4">
            Aquí se integrará el calendario de Calendly
          </p>
          <div class="text-xs text-gray-400">
            URL: {calendlyUrl}
          </div>
        </div>

        <!-- Nota informativa -->
        <div class="mt-6 p-4 bg-primary-light/20 rounded-lg">
          <div class="flex items-start space-x-3">
            <svg
              class="w-5 h-5 text-primary mt-0.5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"></path>
            </svg>
            <div class="text-sm text-neutral-dark/80">
              <strong>Nota:</strong> Las sesiones tienen una duración de 60-90 minutos.
              Recibirás un enlace de Zoom 15 minutos antes de tu cita.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Información adicional -->
    <div class="mt-16 text-center">
      <div class="bg-primary-light/10 rounded-2xl p-8 max-w-4xl mx-auto">
        <h3 class="text-2xl font-display font-semibold text-primary-dark mb-4">
          ¿Tienes dudas sobre el proceso?
        </h3>
        <p class="text-neutral-dark/80 mb-6">
          Nuestro equipo está aquí para ayudarte. Puedes contactarnos por
          WhatsApp o email para resolver cualquier pregunta antes de agendar.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contacto" class="btn-secondary"> Contactar por email </a>
          <a href="/servicios" class="btn-primary">
            Ver servicios disponibles
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

