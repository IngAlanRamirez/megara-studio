---
export interface Props {
  title?: string;
  subtitle?: string;
  disclaimer?: string;
}

const {
  title = "¿Te gusta lo que lees?",
  subtitle = "Suscríbete a mi newsletter y recibe artículos exclusivos sobre sanación holística, herramientas prácticas y reflexiones para tu crecimiento personal.",
  disclaimer = "Sin spam. Solo contenido valioso para tu bienestar.",
} = Astro.props;
---

<section class="bg-background py-20 lg:py-32">
  <div class="container mx-auto px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h2
        class="text-3xl md:text-4xl font-display font-bold text-primary-dark mb-6"
      >
        {title}
      </h2>
      <p class="text-xl text-neutral-dark/80 mb-8 leading-relaxed">
        {subtitle}
      </p>

      <form class="flex flex-col gap-4 max-w-md mx-auto">
        <input
          type="email"
          placeholder="Tu email"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-colors text-base"
          required
        />
        <button
          type="submit"
          class="w-full px-6 py-2 bg-primary text-white font-medium rounded-lg hover:bg-primary-dark transition-colors duration-300 shadow-md hover:shadow-lg text-sm"
        >
          Suscribirse
        </button>
      </form>

      <p class="text-sm text-neutral-dark/60 mt-4">
        {disclaimer}
      </p>
    </div>
  </div>
</section>

<script>
  // Funcionalidad del formulario de newsletter
  const form = document.querySelector("form");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const emailInput = form.querySelector(
      'input[type="email"]'
    ) as HTMLInputElement;
    const email = emailInput?.value;

    if (!email) {
      alert("Por favor ingresa tu email");
      return;
    }

    // Aquí iría la lógica real de suscripción
    // Por ahora solo simulamos el envío
    try {
      // Simular envío
      await new Promise((resolve) => setTimeout(resolve, 1000));

      // Mostrar mensaje de éxito
      alert(
        "¡Gracias por suscribirte! Te enviaremos contenido valioso pronto."
      );

      // Limpiar formulario
      emailInput.value = "";
    } catch (error) {
      alert("Hubo un error al suscribirte. Inténtalo de nuevo.");
    }
  });
</script>
