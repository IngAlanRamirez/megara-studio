---
import { getNavigation, getSiteInfo } from "../utils/content";

// Estado para el menú móvil
let isMenuOpen = false;

const navigation = getNavigation();
const siteInfo = getSiteInfo();
---

<nav
  class="bg-surface/95 backdrop-blur-sm border-b border-primary-light/50 sticky top-0 z-50"
>
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <!-- Logo/Nombre del negocio -->
      <a href="/" class="flex items-center space-x-3 group">
        <img
          src="/assets/logo/megara_studio.jpeg"
          alt="Megara Studio Logo"
          class="w-10 h-10 rounded-full object-cover shadow-sm"
        />
        <span
          class="text-xl font-display font-bold text-primary-dark group-hover:text-primary transition-colors duration-200"
        >
          {siteInfo.name}
        </span>
      </a>

      <!-- Navegación Desktop -->
      <div class="hidden lg:flex items-center space-x-8">
        <a
          href="/"
          class="text-neutral-dark hover:text-primary transition-colors duration-200 font-medium relative group"
        >
          {navigation.home}
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-200"
          ></span>
        </a>
        <a
          href="/sobre-megara"
          class="text-neutral-dark hover:text-primary transition-colors duration-200 font-medium relative group"
        >
          {navigation.about}
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-200"
          ></span>
        </a>
        <a
          href="/servicios"
          class="text-neutral-dark hover:text-primary transition-colors duration-200 font-medium relative group"
        >
          {navigation.services}
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-200"
          ></span>
        </a>
        <a
          href="/blog"
          class="text-neutral-dark hover:text-primary transition-colors duration-200 font-medium relative group"
        >
          {navigation.blog}
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-200"
          ></span>
        </a>
        <a
          href="/contacto"
          class="text-neutral-dark hover:text-primary transition-colors duration-200 font-medium relative group"
        >
          {navigation.contact}
          <span
            class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary group-hover:w-full transition-all duration-200"
          ></span>
        </a>
      </div>

      <!-- Botón CTA Desktop -->
      <div class="hidden lg:block">
        <a href="/agendar" class="btn-primary"> {navigation.bookSession} </a>
      </div>

      <!-- Botón menú móvil -->
      <button
        class="lg:hidden p-2 rounded-lg hover:bg-primary-light/20 transition-colors duration-200"
        aria-label="Abrir menú"
        id="menu-toggle"
      >
        <svg
          class="w-6 h-6 text-neutral-dark"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Menú móvil -->
    <div
      class="lg:hidden hidden bg-surface/95 backdrop-blur-sm border-t border-primary-light/50"
      id="mobile-menu"
    >
      <div class="px-4 py-6 space-y-4">
        <a
          href="/"
          class="block text-neutral-dark hover:text-primary transition-colors duration-200 font-medium py-2 border-b border-primary-light/30"
        >
          {navigation.home}
        </a>
        <a
          href="/sobre-megara"
          class="block text-neutral-dark hover:text-primary transition-colors duration-200 font-medium py-2 border-b border-primary-light/30"
        >
          {navigation.about}
        </a>
        <a
          href="/servicios"
          class="block text-neutral-dark hover:text-primary transition-colors duration-200 font-medium py-2 border-b border-primary-light/30"
        >
          {navigation.services}
        </a>
        <a
          href="/blog"
          class="block text-neutral-dark hover:text-primary transition-colors duration-200 font-medium py-2 border-b border-primary-light/30"
        >
          {navigation.blog}
        </a>
        <a
          href="/contacto"
          class="block text-neutral-dark hover:text-primary transition-colors duration-200 font-medium py-2 border-b border-primary-light/30"
        >
          {navigation.contact}
        </a>
        <div class="pt-4">
          <a href="/agendar" class="btn-primary block w-full text-center">
            {navigation.bookSession}
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  // Funcionalidad del menú móvil
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");

      // Cambiar el ícono del botón
      const svg = menuToggle.querySelector("svg");
      if (svg) {
        if (mobileMenu.classList.contains("hidden")) {
          svg.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>';
        } else {
          svg.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>';
        }
      }
    });

    // Cerrar menú al hacer clic en un enlace
    const mobileLinks = mobileMenu.querySelectorAll("a");
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        const svg = menuToggle?.querySelector("svg");
        if (svg) {
          svg.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>';
        }
      });
    });
  }
</script>
