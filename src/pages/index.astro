---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Megara Studio - Consultorio de Sanación Integral">
  <div class="container mx-auto px-4 py-12">
    <div class="text-center max-w-4xl mx-auto">
      <h1
        class="text-5xl md:text-6xl font-display font-bold text-primary-dark mb-6"
      >
        Sanación <span class="text-accent">Integral</span>
      </h1>
      <p class="text-xl text-neutral-dark mb-8 max-w-2xl mx-auto">
        Bienvenida a tu espacio de transformación y sanación emocional, física y
        espiritual
      </p>
      <p class="text-lg text-neutral-dark/80 mb-12 max-w-3xl mx-auto">
        Descubre el poder de la biodescodificación, el biomagnetismo, el tarot
        terapéutico y más técnicas holísticas para tu bienestar integral
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button
          class="bg-primary hover:bg-primary-dark text-white font-medium py-3 px-8 rounded-lg transition-colors duration-200"
        >
          Agendar Sesión
        </button>
        <button
          class="bg-secondary hover:bg-secondary-dark text-white font-medium py-3 px-8 rounded-lg transition-colors duration-200"
        >
          Conoce Mis Servicios
        </button>
      </div>
    </div>
  </div>
</BaseLayout>
