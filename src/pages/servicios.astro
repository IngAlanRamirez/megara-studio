---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiciosComponent from "../components/Servicios.astro";
---

<BaseLayout
  title="Servicios de Sanación Holística - Megara Studio | Biodescodificación, Reiki, Tarot"
  description="Descubre nuestras terapias holísticas: biodescodificación, biomagnetismo, tarot terapéutico, círculos de mujeres, constelaciones, reiki y sanación con cacao. Sesiones online disponibles."
  type="website"
>
  <!-- Hero Section -->
  <section class="bg-primary-light/10 py-20 lg:py-32">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-4xl mx-auto">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-primary-dark mb-6"
        >
          Servicios de Sanación
        </h1>
        <p class="text-xl text-neutral-dark/80 mb-8 leading-relaxed">
          Terapias holísticas diseñadas para acompañarte en tu proceso de
          transformación personal. Cada servicio está adaptado a tus necesidades
          específicas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/agendar" class="btn-primary"> Agenda tu sesión </a>
          <a href="/contacto" class="btn-secondary"> Consulta personalizada </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Componente de Servicios -->
  <ServiciosComponent />

  <!-- Información adicional sobre el proceso -->
  <section class="bg-surface py-20 lg:py-32">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-primary-dark mb-6"
        >
          ¿Cómo Trabajamos?
        </h2>
        <p
          class="text-xl text-neutral-dark/80 max-w-3xl mx-auto leading-relaxed"
        >
          Un proceso personalizado y respetuoso para tu sanación
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div
            class="w-20 h-20 bg-primary-light/30 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <span class="text-2xl font-display font-bold text-primary-dark"
              >1</span
            >
          </div>
          <h3 class="text-xl font-display font-semibold text-primary-dark mb-4">
            Consulta Inicial
          </h3>
          <p class="text-neutral-dark/80">
            Conversamos sobre tus necesidades y objetivos para determinar la
            terapia más adecuada.
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-20 h-20 bg-secondary-light/30 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <span class="text-2xl font-display font-bold text-secondary-dark"
              >2</span
            >
          </div>
          <h3 class="text-xl font-display font-semibold text-primary-dark mb-4">
            Sesión Personalizada
          </h3>
          <p class="text-neutral-dark/80">
            Realizamos la terapia elegida en un ambiente seguro y confidencial.
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-20 h-20 bg-accent/20 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <span class="text-2xl font-display font-bold text-accent-dark"
              >3</span
            >
          </div>
          <h3 class="text-xl font-display font-semibold text-primary-dark mb-4">
            Integración
          </h3>
          <p class="text-neutral-dark/80">
            Te proporciono herramientas para integrar los cambios en tu vida
            diaria.
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-20 h-20 bg-primary-light/30 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <span class="text-2xl font-display font-bold text-primary-dark"
              >4</span
            >
          </div>
          <h3 class="text-xl font-display font-semibold text-primary-dark mb-4">
            Seguimiento
          </h3>
          <p class="text-neutral-dark/80">
            Acompañamiento continuo para asegurar tu progreso y bienestar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-light/10 py-20 lg:py-32">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto">
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-primary-dark mb-6"
        >
          ¿No sabes cuál elegir?
        </h2>
        <p class="text-xl text-neutral-dark/80 mb-8 leading-relaxed">
          Agenda una consulta gratuita de 15 minutos y te ayudo a identificar
          qué terapia es la más adecuada para ti.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contacto" class="btn-primary"> Consulta gratuita </a>
          <a href="/agendar" class="btn-secondary"> Agenda tu sesión </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
